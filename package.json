{
	"name": "plantir-uikit",
	"version": "1.0.0",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"package": "svelte-kit sync && svelte-package && publint",
		"prepublishOnly": "npm run package",
		"test": "npm run test:integration && npm run test:unit",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:integration": "playwright test",
		"test:unit": "vitest"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^5.2.12",
		"@sveltejs/kit": "^2.18.0",
		"@sveltejs/vite-plugin-svelte": "^5.0.3",
		"@tailwindcss/vite": "^4.0.10",
		"@types/node": "^22.13.9",
		"mdsvex": "^0.12.3",
		"mdsvexamples": "^0.5.0",
		"prettier": "^3.5.3",
		"prettier-plugin-svelte": "^3.3.3",
		"prettier-plugin-tailwindcss": "^0.6.11",
		"sass-embedded": "^1.89.1",
		"svelte": "^5.22.5",
		"svelte-check": "^4.1.4",
		"tailwindcss": "^4.0.10",
		"typescript": "^5.8.2",
		"vite": "^6.2.0"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"style": "./dist/css/app.css",
			"main": "./dist/index.js",
			"svelte": "./dist/index.js"
		},
		"./css/*": "./dist/css/*",
		"./components/*": "./dist/components/*"
	},
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"description": "Plantir UiKit Library",
	"main": "dist/index.js",
	"directories": {
		"test": "tests"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/plantir/uikit.git"
	},
	"keywords": [
		"svelte",
		"uikit",
		"svelte",
		"sveltejs",
		"tailwind",
		"tailwindcss",
		"daisyui",
		"svelte components",
		"svelte ui components",
		"svelte daisyui",
		"svelte tailwind",
		"svelte-kit",
		"sveltekit"
	],
	"author": "arminkheirkhahan",
	"license": "ISC",
	"bugs": {
		"url": "https://github.com/plantir/uikit/issues"
	},
	"homepage": "https://github.com/plantir/uikit#readme",
	"peerDependencies": {
		"svelte": "^5.0.0",
		"@sveltejs/kit": "^2.18.0"
	},
	"dependencies": {
		"@floating-ui/dom": "^1.6.13",
		"@sveltejs/package": "^2.3.10",
		"daisyui": "^5.0.43",
		"flatpickr": "^4.6.13",
		"highlight.js": "^11.11.1",
		"lodash-es": "^4.17.21",
		"moment": "^2.30.1",
		"swiper": "^11.2.5",
		"theme-change": "^2.5.0"
	}
}
